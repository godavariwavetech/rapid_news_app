default_platform(:ios)

platform :ios do
  before_all do
    setup_ci if ENV["CI"]

    app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_API_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_API_KEY_CONTENT"],
      is_key_content_base64: false,
      in_house: false
    )
  end

  desc "Fetch (or create, on first run) the App Store distribution cert + provisioning profile"
  lane :certificates do
    match(type: "appstore", readonly: ENV["CI"] ? true : false)
  end

  desc "Build and upload a new build to TestFlight"
  lane :beta do
    # setup_ci forces match readonly on CI as a safety default. We want CI to
    # be able to create the distribution cert on its first-ever run; once it
    # exists, fetching it again here is a no-op either way.
    match(type: "appstore", readonly: false)

    update_code_signing_settings(
      use_automatic_signing: false,
      path: "rapidnews.xcodeproj",
      team_id: "PU79FB3RAD",
      code_sign_identity: "Apple Distribution",
      bundle_identifier: "com.rapidnews",
      profile_name: ENV["sigh_com.rapidnews_appstore_profile-name"]
    )

    cocoapods(
      podfile: "Podfile",
      try_repo_update_on_error: true
    )

    # latest_testflight_build_number queries App Store Connect, which doesn't
    # immediately reflect a build still "Processing" right after an upload -
    # so right after a prior run, it can under-report and collide again
    # ("must be higher than the previously uploaded version"). A timestamp is
    # always bigger than any small build number and needs no ASC round trip,
    # so it can't lag behind what Apple actually has on file.
    increment_build_number(
      build_number: Time.now.strftime("%Y%m%d%H%M"),
      xcodeproj: "rapidnews.xcodeproj"
    )

    build_app(
      workspace: "rapidnews.xcworkspace",
      scheme: "rapidnews",
      export_method: "app-store",
      output_directory: "build",
      output_name: "RapidNews.ipa",
      clean: true
    )

    upload_to_testflight(
      skip_waiting_for_build_processing: true,
      skip_submission: true,
      apple_id: ENV["APP_STORE_CONNECT_APP_APPLE_ID"]
    )
  end
end
